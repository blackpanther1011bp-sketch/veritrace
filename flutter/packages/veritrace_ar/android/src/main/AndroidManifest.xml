<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- RA 3D facultative : l'app reste installable sur les téléphones sans ARCore
         (le scanner classique y fonctionne toujours). -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application>
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name="com.veritrace.ar.ArActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>
</manifest>
